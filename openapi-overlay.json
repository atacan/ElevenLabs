      "remove": true
    },
    {
      "target": "$.paths['/v1/speech-to-text'].post.requestBody.content['multipart/form-data'].schema.properties",
      "update": {
        "additional_formats": {
          "description": "Additional transcript formats, encoded together as one JSON array part.",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/ExportOptions"
              },
              "maxItems": 10
            }
          ]
